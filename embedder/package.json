{
	"name": "embedder",
	"private": true,
	"type": "module",
	"module": "index.ts",
	"scripts": {
		"setup:docling": "curl -fsSL https://raw.githubusercontent.com/docling-project/docling.rs/master/scripts/install/download_dependencies.sh | sh",
		"setup:tokenizer": "wget https://huggingface.co/intfloat/multilingual-e5-small/resolve/main/tokenizer.json",
