		"db:push": "drizzle-kit push"
	},
	"dependencies": {
		"@huggingface/transformers": "^4.2.0",
		"@libsql/client": "^0.17.4",
		"docling.rs": "^1.19.0",
		"drizzle-orm": "^1.0.0-rc.4",
		"sharp": "^0.35.4"
	},
	"devDependencies": {
		"@types/bun": "^1.4.0",
		"drizzle-kit": "^1.0.0-rc.4"
	},
	"peerDependencies": {
		"typescript": "^5"
	}
}
